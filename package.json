{
  "name": "streaming-backbone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n admin,server -c cyan,magenta \"pnpm --filter @streaming/admin dev\" \"pnpm --filter @streaming/server dev\"",
    "build:admin": "pnpm --filter @streaming/admin build",
    "build:server": "pnpm --filter @streaming/server build",
    "build": "pnpm build:admin && pnpm build:server && node scripts/copy-admin-build.mjs",
    "start": "pnpm --filter @streaming/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @streaming/server db:generate",
    "db:migrate": "pnpm --filter @streaming/server db:migrate",
    "db:studio": "pnpm --filter @streaming/server db:studio",
    "db:seed": "pnpm --filter @streaming/server db:seed",
    "db:migrate:prod": "node apps/server/dist/migrate.js",
    "db:seed:prod": "node apps/server/dist/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
