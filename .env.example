DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streaming_backbone

# TLS for the Postgres connection: auto | require | disable.
# "auto" uses TLS for every host except localhost, which is what a managed
# provider (Neon) needs and what a local server does not.
DATABASE_SSL=auto

# Connection string for the migration runner, when it must differ from the
# app's. Neon: point this at the DIRECT (non "-pooler") host — the pooled
# endpoint cannot hold the session advisory lock the migrator takes.
# Leave blank for a plain Postgres.
MIGRATION_DATABASE_URL=

# Pooled connections held by one instance. Neon's limit is per project, so
# leave room for every instance pointing at the same database.
DATABASE_POOL_MAX=10

PORT=3000
NODE_ENV=development

# Reverse-proxy hops in front of this process: a number, or false for none.
# Every rate limiter keys on the client IP, so behind a proxy this must be set
# or all traffic shares a single bucket. Koyeb is one hop.
TRUST_PROXY=false
# Generate your own: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-plus-random-characters
STORAGE_DIR=./storage
STORAGE_URL_PREFIX=http://localhost:3000/storage
# Ceiling for a bulk playlist (.m3u/.m3u8) upload, in megabytes.
IMPORT_MAX_FILE_SIZE_MB=50

SENTRY_DSN=
VITE_SENTRY_DSN=

# First ADMIN account, created by `pnpm db:seed` when no active ADMIN exists.
# Seed-time only — the password is argon2-hashed on insert and never logged.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_ADMIN_NAME=Platform Admin

# Rolling retention window for device watch events, in days (Phase 15).
# Enforced inside the ingestion transaction; there is no background job.
WATCH_EVENT_RETENTION_DAYS=180
